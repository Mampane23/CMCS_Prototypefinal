@model IEnumerable<CMCS.Models.Claim>

@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-person-badge"></i> Lecturer Dashboard</h2>
            <p class="text-muted">Manage your monthly claims and track their status</p>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Submit New Claim
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Total Claims</h5>
                    <h2 class="display-4">@ViewBag.TotalClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Pending</h5>
                    <h2 class="display-4">@ViewBag.PendingClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Approved</h5>
                    <h2 class="display-4">@ViewBag.ApprovedClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body">
                    <h5 class="card-title">Rejected</h5>
                    <h2 class="display-4">@ViewBag.RejectedClaims</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Claims Table -->
    <div class="card shadow">
        <div class="card-header bg-light">
            <h5 class="mb-0">My Claims</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Claim ID</th>
                                <th>Lecturer Name</th>
                                <th>Module</th>
                                <th>Hours Worked</th>
                                <th>Hourly Rate</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td>@item.LecturerName</td>
                                    <td>@(item.ModuleCode ?? "N/A")</td>
                                    <td>@item.HoursWorked hrs</td>
                                    <td>R @item.HourlyRate.ToString("N2")</td>
                                    <td><strong>R @item.TotalAmount.ToString("N2")</strong></td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock"></i> Pending
                                            </span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Approved
                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Rejected
                                            </span>
                                        }
                                    </td>
                                    <td>@item.SubmissionDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="#" class="btn btn-sm btn-info" title="View Details" data-bs-toggle="modal" data-bs-target="#detailsModal@(item.Id)">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (item.Status == "Pending")
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                <!-- Details Modal -->
                                <div class="modal fade" id="detailsModal@(item.Id)" tabindex="-1">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header bg-primary text-white">
                                                <h5 class="modal-title">Claim Details - #@item.Id</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <strong>Lecturer Name:</strong>
                                                        <p>@item.LecturerName</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <strong>Email:</strong>
                                                        <p>@(item.LecturerEmail ?? "Not provided")</p>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <strong>Department:</strong>
                                                        <p>@(item.Department ?? "Not specified")</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <strong>Module Code:</strong>
                                                        <p>@(item.ModuleCode ?? "Not specified")</p>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <div class="col-md-4">
                                                        <strong>Hours Worked:</strong>
                                                        <p class="text-primary h5">@item.HoursWorked hrs</p>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <strong>Hourly Rate:</strong>
                                                        <p class="text-primary h5">R @item.HourlyRate.ToString("N2")</p>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <strong>Total Amount:</strong>
                                                        <p class="text-success h4">R @item.TotalAmount.ToString("N2")</p>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <div class="col-md-6">
                                                        <strong>Status:</strong>
                                                        <p>
                                                            @if (item.Status == "Pending")
                                                            {
                                                                <span class="badge bg-warning text-dark">Pending</span>
                                                            }
                                                            else if (item.Status == "Approved")
                                                            {
                                                                <span class="badge bg-success">Approved</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-danger">Rejected</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <strong>Submission Date:</strong>
                                                        <p>@item.SubmissionDate.ToString("dd MMM yyyy HH:mm")</p>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.Comments))
                                                {
                                                    <div class="alert alert-info">
                                                        <strong>Reviewer Comments:</strong>
                                                        <p class="mb-0">@item.Comments</p>
                                                        <small class="text-muted">Reviewed by: @item.ReviewedBy on @item.ReviewedDate?.ToString("dd MMM yyyy")</small>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(item.UploadedFiles))
                                                {
                                                    <div class="mb-3">
                                                        <strong>Supporting Documents:</strong>
                                                        <p>
                                                            <a href="~/uploads/@item.UploadedFiles" target="_blank" class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-file-earmark-text"></i> View Document
                                                            </a>
                                                        </p>
                                                    </div>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                    <h4 class="mt-3">No claims submitted yet</h4>
                    <p class="text-muted">Click the button above to submit your first claim</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Submit Your First Claim
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}