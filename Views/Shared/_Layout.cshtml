<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contract Monthly Claim System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-file-earmark-text"></i> CMCS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-badge"></i> Lecturer
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Lecturer" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Lecturer" asp-action="Create">Submit Claim</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-briefcase"></i> Coordinator
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Coordinator" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Coordinator" asp-action="PendingClaims">Pending Claims</a></li>
                                <li><a class="dropdown-item" asp-controller="Coordinator" asp-action="ApprovedClaims">Approved Claims</a></li>
                                <li><a class="dropdown-item" asp-controller="Coordinator" asp-action="RejectedClaims">Rejected Claims</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-people"></i> HR
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="HR" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="HR" asp-action="ApprovedClaims">Process Payments</a></li>
                                <li><a class="dropdown-item" asp-controller="HR" asp-action="GenerateReport">Generate Reports</a></li>
                                <li><a class="dropdown-item" asp-controller="HR" asp-action="LecturerManagement">Manage Lecturers</a></li>
                                <li><a class="dropdown-item" asp-controller="HR" asp-action="Statistics">Statistics</a></li>
                            </ul>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="bi bi-calendar"></i> @DateTime.Now.ToString("dd MMM yyyy")
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3" style="min-height: calc(100vh - 180px);">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted bg-light mt-5">
        <div class="container py-3">
            <div class="row">
                <div class="col-md-6">
                    &copy; 2024 - Contract Monthly Claim System
                </div>
                <div class="col-md-6 text-end">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>