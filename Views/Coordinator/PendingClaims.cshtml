@model IEnumerable<CMCS.Models.Claim>
@{
    ViewData["Title"] = "Pending Claims";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-clock-history"></i> Pending Claims</h2>
            <p class="text-muted">Review and approve pending lecturer claims</p>
        </div>
        <div class="col-auto">
            <a class="btn btn-success" asp-action="ExportToCSV" asp-route-status="Pending">
                <i class="bi bi-file-earmark-spreadsheet"></i> Export to CSV
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Claim ID</th>
                                <th>Lecturer Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Module</th>
                                <th>Hours</th>
                                <th>Rate</th>
                                <th>Total Amount</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td><strong>#@claim.Id</strong></td>
                                    <td>@claim.LecturerName</td>
                                    <td>@(claim.LecturerEmail ?? "N/A")</td>
                                    <td>@(claim.Department ?? "N/A")</td>
                                    <td>@(claim.ModuleCode ?? "N/A")</td>
                                    <td>@claim.HoursWorked hrs</td>
                                    <td>R @claim.HourlyRate.ToString("N2")</td>
                                    <td><strong>R @claim.TotalAmount.ToString("N2")</strong></td>
                                    <td>@claim.SubmissionDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <a asp-action="Review" asp-route-id="@claim.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-clipboard-check"></i> Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No pending claims at the moment.
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}