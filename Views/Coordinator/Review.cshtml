@model CMCS.Models.Claim

@{
    ViewData["Title"] = "Review Claim";
    var validationResults = ViewBag.ValidationResults as Dictionary<string, string>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-clipboard-check"></i> Review Claim #@Model.Id</h4>
                </div>
                <div class="card-body">
                    <h5 class="border-bottom pb-2">Claim Information</h5>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Lecturer Name:</strong>
                            <p>@Model.LecturerName</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Email:</strong>
                            <p>@(Model.LecturerEmail ?? "Not provided")</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Department:</strong>
                            <p>@(Model.Department ?? "Not specified")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Module Code:</strong>
                            <p>@(Model.ModuleCode ?? "Not specified")</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Hours Worked:</strong>
                            <p class="text-primary h5">@Model.HoursWorked hrs</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Hourly Rate:</strong>
                            <p class="text-primary h5">R @Model.HourlyRate.ToString("N2")</p>
                        </div>
                        <div class="col-md-4">
                            <strong>Total Amount:</strong>
                            <p class="text-success h4">R @Model.TotalAmount.ToString("N2")</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Claim Month:</strong>
                            <p>@(Model.ClaimMonth ?? "Not specified")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Submission Date:</strong>
                            <p>@Model.SubmissionDate.ToString("dd MMM yyyy HH:mm")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.UploadedFiles))
                    {
                        <div class="mb-3">
                            <strong>Supporting Documents:</strong>
                            <p>
                                <a href="~/uploads/@Model.UploadedFiles" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-file-earmark-text"></i> View Document
                                </a>
                            </p>
                        </div>
                    }

                    <hr />

                    <h5 class="border-bottom pb-2 mt-4">Approval Decision</h5>
                    
                    <form id="reviewForm">
                        <div class="mb-3">
                            <label for="comments" class="form-label">Comments / Feedback</label>
                            <textarea class="form-control" id="comments" name="comments" rows="4" 
                                      placeholder="Enter your comments here..."></textarea>
                            <small class="text-muted">Required when rejecting a claim</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="PendingClaims" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="button" class="btn btn-danger" onclick="rejectClaim()">
                                <i class="bi bi-x-circle"></i> Reject Claim
                            </button>
                            <button type="button" class="btn btn-success" onclick="approveClaim()">
                                <i class="bi bi-check-circle"></i> Approve Claim
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-robot"></i> Automated Validation</h5>
                </div>
                <div class="card-body">
                    @if (validationResults != null)
                    {
                        @foreach (var result in validationResults)
                        {
                            <div class="mb-3">
                                <strong>@result.Key:</strong>
                                <p class="mb-0">@Html.Raw(result.Value)</p>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Quick Guidelines</h6>
                </div>
                <div class="card-body">
                    <ul class="small">
                        <li>Verify hours worked against timesheet</li>
                        <li>Check hourly rate matches contract</li>
                        <li>Ensure supporting documents are provided</li>
                        <li>Validate total calculation</li>
                        <li>Always provide feedback comments</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden forms for approve/reject -->
<form id="approveForm" asp-action="Approve" asp-route-id="@Model.Id" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="comments" id="approveComments" />
</form>

<form id="rejectForm" asp-action="Reject" asp-route-id="@Model.Id" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="comments" id="rejectComments" />
</form>

@section Scripts {
    <script>
        function approveClaim() {
            var comments = document.getElementById('comments').value;
            
            if (confirm('Are you sure you want to APPROVE this claim?')) {
                document.getElementById('approveComments').value = comments;
                document.getElementById('approveForm').submit();
            }
        }

        function rejectClaim() {
            var comments = document.getElementById('comments').value;
            
            if (!comments.trim()) {
                alert('Please provide comments when rejecting a claim.');
                return;
            }
            
            if (confirm('Are you sure you want to REJECT this claim? This action cannot be undone.')) {
                document.getElementById('rejectComments').value = comments;
                document.getElementById('rejectForm').submit();
            }
        }
    </script>
}